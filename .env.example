# Local secrets — copy values into `.env.local` (gitignored). Never commit real passwords.
#
# Maestro E2E auto login (dev client only; ignored when __DEV__ is false):
# EXPO_PUBLIC_E2E_LOGIN=true
# EXPO_PUBLIC_E2E_LOGIN_EMAIL=
# EXPO_PUBLIC_E2E_LOGIN_PASSWORD=
#
# App Store review password login (optional):
# EXPO_PUBLIC_APP_REVIEW_LOGIN_EMAIL=

# PostHog product analytics (also sent from the local dev client; events are tagged app_environment=development):
# Put these on EAS Production (and Preview if you want those builds tracked).
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
